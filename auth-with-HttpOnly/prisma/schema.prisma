generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

model User {
  id                String       @id @default(uuid())
  
  email             String       @unique
  password          String?

  authProvider      AuthProvider @default(LOCAL)
  providerAccountId String?

  isEmailVerified Boolean  @default(false)
  role             UserRole @default(USER)

  totpSecret         String?
  isTwoFactorEnabled Boolean  @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationOtps  VerificationOtp[]
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]

  @@unique([authProvider, providerAccountId])
}

model VerificationOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String

  // Rotation chain
  familyId   String

  // Login/device session
  sessionId  String

  // Actual refresh-token credential
  tokenHash  String

  // Token lifecycle
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  replacedAt DateTime?
  revokedAt  DateTime?

  // Device information
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String?
  eventType AuditEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REGISTER
  EMAIL_VERIFIED
  PASSWORD_RESET
  ACCOUNT_LOCKED
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
}
