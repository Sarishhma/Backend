# ── Server ──────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Postgres) ─────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/auth_backend?schema=public"

# ── JWT Secrets ──────────────────────────
JWT_ACCESS_SECRET="replace-with-generated-64-byte-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-DIFFERENT-generated-64-byte-hex-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── OTP Config ───────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Email (for sending OTP codes) ────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="youraddress@gmail.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_FROM="Auth Backend <no-reply@yourapp.com>"

# ── CORS ─────────────────────────────────
FRONTEND_ORIGIN="http://localhost:5173"

# ── Rate Limiting ────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW="1 minute"

